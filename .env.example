# ---------------------------------------------------------------------------
# Business OS — environment template
#
# Copy to .env and fill in. Never commit a populated .env.
#
# Every variable here is validated at boot by @bos/config (packages/config).
# A missing or malformed value fails the process at startup, not at first use.
# Variables are grouped by the process that reads them; a process reads only
# its own slice, so the public site never needs the database URL and the
# Worker never needs SMTP credentials.
#
# The per-environment values for staging and production are in
# docs/deployment/environments.md. This file is the contract, not the values.
# ---------------------------------------------------------------------------

# --- Runtime (every process) ------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# The port a managed host assigns. Leave unset locally: each app falls back to
# its own default (site 3000, dashboard 3001, API 4000). Hostinger sets it, and
# ignoring it is the most common reason a working build serves nothing.
# PORT=

# --- Database (API) ---------------------------------------------------------
# Postgres 16+. The application connects as `bos_app`, a least-privilege role
# that is NOT the table owner — row-level security does not bind an owner or a
# superuser, so the connection string is load-bearing security, not a
# preference. See docs/database/README.md.
DATABASE_URL=postgresql://bos_app:password@localhost:5432/bos_dev
DATABASE_POOL_MAX=10
# disable | require | verify-full.
# Unset means verify-full in production and disable everywhere else. Managed
# Postgres often needs `require` because its CA is not in the container's trust
# store; that is a decision worth writing down rather than defaulting into.
# DATABASE_SSL=verify-full

# --- Cache and rate limiting (API) -----------------------------------------
# Nothing durable lives here: rate-limit counters, the workspace slug cache and
# short-lived authentication state. A flush costs a few reset counters.
REDIS_URL=redis://localhost:6379

# --- API --------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Browser origins allowed to call the API with credentials. Comma-separated.
# A wildcard is not an option here — the dashboard sends a session cookie.
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 32+ random bytes, base64: `openssl rand -base64 32`
AUTH_SESSION_SECRET=
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
# Scope for session cookies, e.g. `.nuesheba.com`, when the dashboard and API
# share a parent domain. Leave unset in development.
# AUTH_COOKIE_DOMAIN=
# Shown next to the code in an authenticator app.
AUTH_MFA_ISSUER=Business OS

# Shared secret for Worker → API calls and for the site's revalidate endpoint.
# 32+ random bytes. Rotate through the documented two-key overlap window.
EDGE_SHARED_SECRET=
# Key for the analytics visitor HMAC. Rotating it rotates every stored
# pseudonym, which is the point — see docs/architecture/06.
ANALYTICS_HASH_SECRET=

# Where the API tells the site to revalidate, and where it links staff to a lead.
SITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# --- Public site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# CDN origin for public media. Also an allowed `img-src` in the site's CSP.
# NEXT_PUBLIC_MEDIA_ORIGIN=https://assets.nuesheba.com

# --- Dashboard --------------------------------------------------------------
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# --- Active workspace / tenant ---------------------------------------------
# Which business config the site and dashboard serve. See configs/.
BOS_WORKSPACE_SLUG=nuesheba

# ---------------------------------------------------------------------------
# THE LAUNCH SWITCH
#
# `false` (the default) makes the deployment non-indexable: robots.txt
# disallows everything, every page carries `noindex`, and IndexNow submissions
# are skipped. A preview build is a production build, so this is keyed on an
# explicit variable rather than on NODE_ENV — the two are not the same
# question, and confusing them indexes staging.
#
# Set to `true` only on production, and only after the go-live checklist.
# ---------------------------------------------------------------------------
BOS_ALLOW_INDEXING=false

# --- Content provider -------------------------------------------------------
# internal | wordpress | markdown
CONTENT_PROVIDER=internal
# Only read when CONTENT_PROVIDER=wordpress.
WORDPRESS_API_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# --- Object storage (Cloudflare R2) ----------------------------------------
# Two buckets on purpose: public assets are cacheable and permanently
# addressable, documents are neither. Leave every one of these unset to run
# without uploads — half-configured is the dangerous state, so setting any one
# of them makes all of them required.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=bos-assets
R2_PRIVATE_BUCKET=bos-documents
R2_PUBLIC_BASE_URL=
# Seconds a signed document URL stays valid. Minutes, not hours.
R2_SIGNED_URL_TTL=300

# --- Spam protection --------------------------------------------------------
# Cloudflare Turnstile. Without the secret key the public form has no CAPTCHA
# and the API warns at boot; in production it refuses to start.
# The API serves TURNSTILE_SITE_KEY to the site with the form definition, so
# widget and verification are configured in one place and cannot drift apart.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is the site-local fallback for a static build.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Proxy / client-address trust (API) -------------------------------------
# Which upstream hops to believe about the client address. The rate limits and
# the audit trail are keyed on it, so trusting a spoofable header un-keys both.
#   none      trust nothing; the socket peer is the client
#   loopback  (default) a reverse proxy on this host — the documented topology
#   all       any X-Forwarded-For; ONLY safe when the origin is unreachable
#             except through the proxy
#   1..n      trust that many hops
#   a,b/cidr  trust exactly these proxy addresses
API_TRUST_PROXY=loopback

# --- Email ------------------------------------------------------------------
# resend | smtp | ses | log
# `log` writes messages to the log instead of sending them. Fine locally;
# the API refuses to start with it in production.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Business OS
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp ---------------------------------------------------------------
# meta_cloud | log
# A business-initiated message outside the 24-hour service window must use an
# approved template; the acknowledgement uses `lead_received`.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Webhook subscription: the token echoed during Meta's handshake (any random
# string), the app secret that signs every delivery (X-Hub-Signature-256 —
# without it inbound webhooks are refused), and which workspace inbound
# messages belong to. Point Meta at  https://<api>/v1/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_INBOUND_WORKSPACE=nuesheba

# --- Cloudflare edge --------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Search console / indexing ---------------------------------------------
# Also served at https://<site>/<key>.txt, which is how IndexNow verifies it.
INDEXNOW_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Provisioning -----------------------------------------------------------
# Read by `pnpm workspace:provision <slug> --owner-email <email>`. Passed in
# the environment rather than on the command line, which would put it in shell
# history. Never set in a deployed environment.
# BOS_OWNER_PASSWORD=

# --- Tests ------------------------------------------------------------------
# The API suite connects as the least-privilege application role. Under a
# superuser, row-level security does not apply and every cross-tenant test
# passes vacuously — the harness refuses to run against such a role.
# TEST_DATABASE_URL=postgresql://bos_app:password@localhost:5432/bos_dev

# --- Document malware scanning (API) ----------------------------------------
# clamav | stub | none. See docs/security/document-handling.md.
# `none` verifies uploads (size, signature, checksum) but does not scan; with
# storage configured the API treats that as a production blocker. `stub` only
# detects the EICAR test string and refuses to start in production.
DOCUMENT_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
