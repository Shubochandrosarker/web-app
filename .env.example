# ---------------------------------------------------------------------------
# Business OS — environment template
# Copy to .env and fill in. Never commit a populated .env.
# Every variable here is validated at boot by @bos/config (packages/config).
# A missing or malformed value fails the process at startup, not at first use.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# Postgres 16+. The app connects as a least-privilege role, not the owner.
DATABASE_URL=postgresql://bos:bos@localhost:5432/bos_dev
DATABASE_POOL_MAX=10

# --- Cache / rate limiting -------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API -------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# 32+ random bytes, base64. Rotate via the documented two-key overlap window.
AUTH_SESSION_SECRET=
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000

# --- Public site -----------------------------------------------------------
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Dashboard -------------------------------------------------------------
DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# --- Active workspace / tenant --------------------------------------------
# Which business config the site renders. See configs/.
BOS_WORKSPACE_SLUG=nuesheba

# --- Content provider ------------------------------------------------------
# internal | wordpress | markdown
CONTENT_PROVIDER=internal
# Only read when CONTENT_PROVIDER=wordpress.
WORDPRESS_API_URL=
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# --- Object storage (Cloudflare R2) ---------------------------------------
# Two buckets on purpose: public assets are cacheable, documents never are.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=bos-assets
R2_PRIVATE_BUCKET=bos-documents
R2_PUBLIC_BASE_URL=

# --- Cloudflare edge -------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Shared secret the API signs edge-bound requests with (and the Worker verifies).
EDGE_SHARED_SECRET=

# --- Email -----------------------------------------------------------------
# resend | smtp | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Business OS
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Search console / indexing --------------------------------------------
INDEXNOW_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Analytics -------------------------------------------------------------
ANALYTICS_INGEST_URL=http://localhost:8787/collect
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# --- AI providers ----------------------------------------------------------
# cloudflare | anthropic | openai — resolved through the @bos/ai adapter.
AI_PROVIDER=cloudflare
AI_API_KEY=
