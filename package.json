{
  "name": "business-os",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Business Operating System — public site, dashboard, API and edge runtime for multi-business web platforms",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @bos/database run generate",
    "db:migrate": "pnpm --filter @bos/database run migrate",
    "db:status": "pnpm --filter @bos/database run status",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "lint:fix": "eslint . --fix",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "workspace:provision": "pnpm --filter @bos/api run provision",
    "check:readiness": "node --experimental-strip-types scripts/check-readiness.ts",
    "redirects:import": "node --experimental-strip-types scripts/redirects.ts import",
    "redirects:verify": "node --experimental-strip-types scripts/redirects.ts verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "3.6.2",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@bos/business-types": "workspace:*",
    "@bos/database": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "type": "module"
}
